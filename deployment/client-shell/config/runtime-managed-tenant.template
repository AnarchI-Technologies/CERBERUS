# Non-secret managed-tenant runtime settings
# The tenant installer fills PORT with the tenant's unique loopback port.
PORT=
CERBERUS_BIND_HOST=127.0.0.1
CERBERUS_MEMORY_DIR=
CERBERUS_STATE_DIR=
CERBERUS_LOG_DIR=
CERBERUS_MEMORY_BACKEND=sqlite
MONGODB_DATABASE=
CERBERUS_MONGO_COLLECTION_PREFIX=
CERBERUS_MANAGEMENT_HOSTNAME=
CERBERUS_MODEL_GATEWAY_ENABLED=false

# Integrations stay disabled until tenant credentials are installed and approved.
CLAW_ROYALE_RUNTIME_ENABLED=false
CLAW_ROYALE_GAME_MODE=free
CLAW_ROYALE_PAID_LAST_SLOT_ONLY=true
CLAW_ROYALE_DISABLE_PAID_AUTO_UPGRADE=true
CLAW_ROYALE_LOADOUT_OPTIMIZER_ENABLED=false
