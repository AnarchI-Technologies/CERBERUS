[Unit]
Description=CERBERUS managed tenant %i orchestration core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The core intentionally uses the stable host network namespace. Its unique
# 127/8 address survives process restarts; retain the stable host network namespace.
User=cerberus-%i
Group=cerberus-%i
WorkingDirectory=/srv/cerberus-tenants/%i/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TENANT_ID=%i
Environment=CLAW_ROYALE_RUNTIME_ENABLED=false
EnvironmentFile=/etc/cerberus-tenants/%i/runtime.env
EnvironmentFile=/etc/cerberus-tenants/%i/credentials.env
EnvironmentFile=/etc/cerberus-tenants/%i/core.env
ExecStart=/usr/bin/env CLAW_ROYALE_RUNTIME_ENABLED=false /srv/cerberus-tenants/%i/venv-current/bin/python /srv/cerberus-tenants/%i/current/runtime/secure_core_launcher.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/var/log/cerberus-tenants/%i/core.log
StandardError=append:/var/log/cerberus-tenants/%i/core.log

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cerberus-tenants/%i
ReadWritePaths=/var/log/cerberus-tenants/%i
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
