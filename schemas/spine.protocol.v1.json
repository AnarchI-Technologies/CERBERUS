{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarchi.local/schemas/spine.protocol.v1.json",
  "title": "CERBERUS Spine Protocol v1",
  "description": "Read-first session and snapshot documents shared by Helm and Vigil.",
  "oneOf": [
    { "$ref": "#/$defs/session" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "kind", "observed_at", "system"],
      "properties": {
        "schema_version": { "const": "cerberus.spine.v1" },
        "kind": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "system": { "const": "CERBERUS" }
      }
    },
    "surface": { "enum": ["helm", "vigil", "unknown"] },
    "reach": {
      "type": "array",
      "contains": { "const": "read-only" },
      "uniqueItems": true,
      "items": { "enum": ["read-only", "standard", "remote", "elevated", "time-limited"] }
    },
    "session": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["surface", "reach", "capabilities"],
          "properties": {
            "kind": { "const": "session" },
            "surface": { "$ref": "#/$defs/surface" },
            "reach": { "$ref": "#/$defs/reach" },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "snapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["surface", "reach", "health", "runtime", "memory", "activity", "launch"],
          "properties": {
            "kind": { "const": "snapshot" },
            "surface": { "$ref": "#/$defs/surface" },
            "reach": { "$ref": "#/$defs/reach" },
            "health": { "type": "object" },
            "runtime": { "type": "object" },
            "memory": { "type": "object" },
            "activity": { "type": "object" },
            "launch": { "type": "object" }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["error"],
          "properties": {
            "kind": { "const": "error" },
            "error": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
